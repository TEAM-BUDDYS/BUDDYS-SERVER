{
  "title": "Buddys Server Overview",
  "uid": "buddys-server-overview",
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "type": "row",
      "title": "Service Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100
    },
    {
      "type": "stat",
      "title": "Instance Up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "up{job=\"buddys-server\"}", "legendFormat": "up" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "textMode": "value_and_name" }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "process_uptime_seconds{job=\"buddys-server\"}", "legendFormat": "uptime" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "stat",
      "title": "CPU Usage",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "process_cpu_usage{job=\"buddys-server\"} * 100", "legendFormat": "cpu" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 } }
    },
    {
      "type": "stat",
      "title": "Live Threads",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "jvm_threads_live_threads{job=\"buddys-server\"}", "legendFormat": "threads" }
      ]
    },

    {
      "type": "row",
      "title": "JVM Memory",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 200
    },
    {
      "type": "timeseries",
      "title": "Heap Memory Used vs Max",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{job=\"buddys-server\", area=\"heap\"})", "legendFormat": "used" },
        { "expr": "sum(jvm_memory_max_bytes{job=\"buddys-server\", area=\"heap\"})", "legendFormat": "max" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "timeseries",
      "title": "GC Overhead",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "jvm_gc_overhead{job=\"buddys-server\"}", "legendFormat": "overhead" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },

    {
      "type": "row",
      "title": "HTTP Traffic",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 300
    },
    {
      "type": "timeseries",
      "title": "Request Rate by URI",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 20,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"buddys-server\"}[1m]))", "legendFormat": "{{uri}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "Average Latency by URI",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 21,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{job=\"buddys-server\"}[1m])) / sum by (uri) (rate(http_server_requests_seconds_count{job=\"buddys-server\"}[1m]))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "4xx / 5xx Error Rate",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "id": 22,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"buddys-server\", status=~\"4..|5..\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },

    {
      "type": "row",
      "title": "Database (HikariCP)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 400
    },
    {
      "type": "timeseries",
      "title": "Connection Pool Usage",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "id": 30,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "hikaricp_connections_active{job=\"buddys-server\"}", "legendFormat": "active" },
        { "expr": "hikaricp_connections_idle{job=\"buddys-server\"}", "legendFormat": "idle" },
        { "expr": "hikaricp_connections_pending{job=\"buddys-server\"}", "legendFormat": "pending" },
        { "expr": "hikaricp_connections_max{job=\"buddys-server\"}", "legendFormat": "max" }
      ]
    }
  ]
}
